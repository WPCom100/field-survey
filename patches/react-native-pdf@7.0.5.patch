+#pragma mark viewport reporting (field-survey patch)
+
+/**
+ *  Observe the inner UIScrollView of the PDFView so JS learns every pan/zoom,
+ *  not only the end of a pinch. Idempotent; safe to call before the document loads.
+ */
+- (void)attachScrollObserver
+{
+    UIScrollView *found = nil;
+    for (UIView *subview in _pdfView.subviews) {
+        if ([subview isKindOfClass:[UIScrollView class]]) {
+            found = (UIScrollView *)subview;
+            break;
+        }
+    }
+    if (found == _observedScrollView) return;
+    [self detachScrollObserver];
+    if (found) {
+        [found addObserver:self forKeyPath:@"contentOffset" options:NSKeyValueObservingOptionNew context:RNPDFViewportKVOContext];
+        _observedScrollView = found;
+    }
+}
+
+- (void)detachScrollObserver
+{
+    if (_observedScrollView) {
+        @try {
+            [_observedScrollView removeObserver:self forKeyPath:@"contentOffset" context:RNPDFViewportKVOContext];
+        } @catch (NSException *e) {}
+        _observedScrollView = nil;
+    }
+    _lastViewport = nil;
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object change:(NSDictionary *)change context:(void *)context
+{
+    if (context == RNPDFViewportKVOContext) {
+        [self emitViewport];
+    } else {
+        [super observeValueForKeyPath:keyPath ofObject:object change:change context:context];
+    }
+}
+
+/**
+ *  viewport|a|b|c|d|tx|ty|cx|cy|cw|ch|page
+ *  [a b c d tx ty] maps PDF user-space points of the current page to points in this view
+ *  (y down), as PDFKit's convertPoint:fromPage: does; cx cy cw ch is the page's CropBox.
+ *  Emitted on every contentOffset / scale change; duplicates are suppressed.
+ */
+- (void)emitViewport
+{
+    if (!_initialed || !_pdfDocument || !_pdfView) return;
+    PDFPage *page = _pdfView.currentPage;
+    if (!page) return;
+    CGPoint o  = [_pdfView convertPoint:CGPointMake(0, 0) fromPage:page];
+    CGPoint ex = [_pdfView convertPoint:CGPointMake(1, 0) fromPage:page];
+    CGPoint ey = [_pdfView convertPoint:CGPointMake(0, 1) fromPage:page];
+    o  = [self convertPoint:o  fromView:_pdfView];
+    ex = [self convertPoint:ex fromView:_pdfView];
+    ey = [self convertPoint:ey fromView:_pdfView];
+    CGRect crop = [page boundsForBox:kPDFDisplayBoxCropBox];
+    unsigned long pageIndex = [_pdfDocument indexForPage:page];
+    NSString *message = [NSString stringWithFormat:@"viewport|%f|%f|%f|%f|%f|%f|%f|%f|%f|%f|%lu",
+                         ex.x - o.x, ex.y - o.y, ey.x - o.x, ey.y - o.y, o.x, o.y,
+                         crop.origin.x, crop.origin.y, crop.size.width, crop.size.height, pageIndex + 1];
+    if (_lastViewport && [_lastViewport isEqualToString:message]) return;
+    _lastViewport = message;
+    [self notifyOnChangeWithMessage:message];
 }
 
