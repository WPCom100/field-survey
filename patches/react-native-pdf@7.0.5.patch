+/**
+ *  field-survey patch: zoom so the rect (PDF user space of the current page) fills the view and
+ *  centre it. Used for "fit" (the CropBox) and to bring a pin or cluster into view. The fit may be
+ *  below minScaleFactor (the stock fit from _fixScaleFactor can be off on the new architecture), so
+ *  the floor is lowered to it: the user can always pinch back out to the whole sheet.
+ */
+- (void)setNativeFocus:(double)x y:(double)y width:(double)width height:(double)height animated:(BOOL)animated
+{
+    if (!_pdfDocument || !_pdfView || width <= 0 || height <= 0) return;
+    PDFPage *page = _pdfView.currentPage ? _pdfView.currentPage : [_pdfDocument pageAtIndex:0];
+    CGSize box = _pdfView.bounds.size;
+    if (!page || box.width <= 0 || box.height <= 0) return;
+
+    CGFloat factor = MIN(box.width / width, box.height / height);
+    if (factor < _pdfView.minScaleFactor) _pdfView.minScaleFactor = factor;
+    if (factor > _pdfView.maxScaleFactor) factor = _pdfView.maxScaleFactor;
+    _pdfView.scaleFactor = factor;
+    [_pdfView layoutIfNeeded];
+
+    [self attachScrollObserver];
+    UIScrollView *scroll = _observedScrollView;
+    if (!scroll) {
+        [_pdfView goToRect:CGRectMake(x, y, width, height) onPage:page];
+        [self emitViewport];
+        return;
+    }
+    CGPoint centre = [_pdfView convertPoint:CGPointMake(x + width / 2, y + height / 2) fromPage:page];
+    centre = [scroll convertPoint:centre fromView:_pdfView];
+    CGSize size = scroll.bounds.size;
+    UIEdgeInsets inset = scroll.adjustedContentInset;
+    CGFloat minX = -inset.left, maxX = scroll.contentSize.width + inset.right - size.width;
+    CGFloat minY = -inset.top, maxY = scroll.contentSize.height + inset.bottom - size.height;
+    CGFloat ox = centre.x - size.width / 2, oy = centre.y - size.height / 2;
+    ox = maxX < minX ? (minX + maxX) / 2 : MIN(MAX(ox, minX), maxX);
+    oy = maxY < minY ? (minY + maxY) / 2 : MIN(MAX(oy, minY), maxY);
+    [scroll setContentOffset:CGPointMake(ox, oy) animated:animated];
+    [self emitViewport];
+}
+
