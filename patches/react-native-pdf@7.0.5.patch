+#import <UIKit/UIGestureRecognizerSubclass.h>
+
+/**
+ *  field-survey patch (T69, D129): ink capture in draw mode. Follows ONE touch (a finger or the
+ *  Apple Pencil) and begins at once, so a stroke starts under the pen without a delay. A second
+ *  finger cancels it, so the two-finger pan (the scroll view's pan needs 2 touches in draw mode)
+ *  and PDFKit's pinch take over without leaving draw mode.
+ */
+@interface RNPDFInkGestureRecognizer : UIGestureRecognizer
+@property (nonatomic, weak) UITouch *trackedTouch;
+@property (nonatomic, strong) UIEvent *lastEvent;
+@end
+
+@implementation RNPDFInkGestureRecognizer
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    [super touchesBegan:touches withEvent:event];
+    NSUInteger down = 0;
+    for (UITouch *t in event.allTouches) {
+        if (t.phase != UITouchPhaseEnded && t.phase != UITouchPhaseCancelled) down++;
+    }
+    if (self.trackedTouch == nil && self.state == UIGestureRecognizerStatePossible && down == 1) {
+        self.trackedTouch = touches.anyObject;
+        self.lastEvent = event;
+        self.state = UIGestureRecognizerStateBegan;
+        return;
+    }
+    // a second finger: hand the gesture to the scroll view (two-finger pan) and PDFKit's pinch
+    for (UITouch *t in touches) {
+        if (t != self.trackedTouch) [self ignoreTouch:t forEvent:event];
+    }
+    if (self.state == UIGestureRecognizerStateBegan || self.state == UIGestureRecognizerStateChanged) {
+        self.state = UIGestureRecognizerStateCancelled;
+    } else if (self.state == UIGestureRecognizerStatePossible) {
+        self.state = UIGestureRecognizerStateFailed;
+    }
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    [super touchesMoved:touches withEvent:event];
+    if (self.trackedTouch && [touches containsObject:self.trackedTouch] &&
+        (self.state == UIGestureRecognizerStateBegan || self.state == UIGestureRecognizerStateChanged)) {
+        self.lastEvent = event;
+        self.state = UIGestureRecognizerStateChanged;
+    }
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    [super touchesEnded:touches withEvent:event];
+    if (self.trackedTouch && [touches containsObject:self.trackedTouch]) {
+        self.lastEvent = event;
+        self.state = (self.state == UIGestureRecognizerStatePossible) ? UIGestureRecognizerStateFailed : UIGestureRecognizerStateEnded;
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    [super touchesCancelled:touches withEvent:event];
+    if (self.trackedTouch && [touches containsObject:self.trackedTouch]) {
+        self.state = (self.state == UIGestureRecognizerStatePossible) ? UIGestureRecognizerStateFailed : UIGestureRecognizerStateCancelled;
+    }
+}
+
+- (void)reset
+{
+    [super reset];
+    self.trackedTouch = nil;
+    self.lastEvent = nil;
+}
+
+@end
