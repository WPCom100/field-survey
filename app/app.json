{
  "expo": {
    "name": "Field Survey",
    "slug": "field-survey",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldsurvey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "productions.luminarytechnology.fieldsurvey",
      "supportsTablet": true,
      "infoPlist": {
        "UIDeviceFamily": [2],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
