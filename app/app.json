{
  "expo": {
    "name": "Field Survey",
    "slug": "field-survey",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldsurvey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "productions.luminarytechnology.fieldsurvey",
      "supportsTablet": true,
      "isTabletOnly": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Field Survey uses the camera to photograph devices, panels and wiring during the survey.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Field Survey attaches photos from your library to survey records.",
          "cameraPermission": "Field Survey uses the camera to photograph devices, panels and wiring during the survey.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01613384-c07a-4547-894f-2cc92ea38dac"
      }
    },
    "owner": "wpcom",
    "updates": {
      "url": "https://u.expo.dev/01613384-c07a-4547-894f-2cc92ea38dac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
