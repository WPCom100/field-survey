# Postgres (read by the postgres service and the app). DATABASE_URL is for host-side
# commands (alembic, pytest, uvicorn); docker-compose.yml points api/worker at host "postgres".
POSTGRES_USER=survey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=survey
DATABASE_URL=postgresql+psycopg://survey:change-me@localhost:5432/survey

# Auth: "token" until Entra sign-in lands (D69)
AUTH_MODE=token
SURVEY_SHARED_TOKEN=change-me
# Comma-separated names for the iPad picker; more can be added with POST /team.
# Switching to AUTH_MODE=entra is the T03 hand-over: it adds JWT validation to
# app.auth.require_token; interim users merge by name on first sign-in. No data migration.
TEAM_NAMES_CSV=Landry

# S3-compatible storage: SeaweedFS (compose service `s3`) locally, Cloudflare R2 elsewhere.
# Host-side commands (pytest's real-bucket tests) need S3_ENDPOINT=http://localhost:9000.
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# keys from an R2 API token with Object Read & Write on the bucket (docs/ops.md).
S3_ENDPOINT=http://s3:9000
S3_REGION=auto
S3_BUCKET=survey
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev

# Backups (docs/ops.md §3). The worker dumps Postgres to S3_BUCKET/backups/pg/ once a day at or
# after BACKUP_HOUR_UTC (08 = 03:00 Houston CDT) and, on BACKUP_COPY_WEEKDAY (ISO, 7 = Sunday),
# copies the whole bucket to BACKUP_COPY_BUCKET with rclone. Copy endpoint/keys default to the
# S3_* ones; set them when the copy bucket needs its own token. Off in local dev.
BACKUP_ENABLED=false
BACKUP_HOUR_UTC=8
BACKUP_RETENTION_DAYS=90
BACKUP_COPY_BUCKET=
BACKUP_COPY_WEEKDAY=7
BACKUP_COPY_ENDPOINT=
BACKUP_COPY_ACCESS_KEY=
BACKUP_COPY_SECRET_KEY=
# Weekly master export to the bucket (D67, T29): ISO weekday, from BACKUP_HOUR_UTC, needs BACKUP_ENABLED.
EXPORT_WEEKLY_WEEKDAY=7

# Largest blob POST /blobs/{sha} accepts (bytes; default 512 MiB)
BLOB_MAX_BYTES=536870912

# Worker runs one job at a time on the 4 GB Droplet
WORKER_CONCURRENCY=1

# Caddy TLS hostname ("localhost" for local dev; survey.wpcom.cloud on the Droplet)
SURVEY_HOSTNAME=localhost
