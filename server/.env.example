# Postgres (read by the postgres service and the app)
POSTGRES_USER=survey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=survey
DATABASE_URL=postgresql+psycopg://survey:change-me@postgres:5432/survey

# Auth: "token" until Entra sign-in lands (D69)
AUTH_MODE=token
SURVEY_SHARED_TOKEN=change-me

# S3-compatible storage: MinIO locally, Cloudflare R2 elsewhere
S3_ENDPOINT=http://minio:9000
S3_BUCKET=survey
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Worker runs one job at a time on the 4 GB Droplet
WORKER_CONCURRENCY=1

# Caddy TLS hostname (use "localhost" for local dev)
SURVEY_HOSTNAME=localhost
